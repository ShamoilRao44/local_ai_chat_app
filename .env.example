# Local model endpoint and its required x-api-key value.
# Copy this file to .env, then replace the key before sending a message.
# Every setting also has a default in server.js; the UI opens without a key.
LLM_BASE_URL=http://172.31.8.100:9005/v1/chat/completions
LLM_API_KEY=paste_your_key_here
DEFAULT_MODEL=qwen3-coder-next-sd-dev
SYSTEM_PROMPT=You are a helpful, concise coding assistant. Prefer clear step-by-step reasoning, minimal fluff, and runnable code examples when relevant.
TEMPERATURE=0.1
REQUEST_TIMEOUT_SECONDS=1500
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/chats.db